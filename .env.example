# ── SafeByte Environment Variables — TEMPLATE ─────────────────────────────────
# Create a .env file in the project root and add your real keys below.
# All keys listed here have FREE tiers.

# 1. Contact Form — EmailJS (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# 2. Malware & URL Scanner — VirusTotal (https://www.virustotal.com)
VITE_VT_API_KEY=f0bc2aa1561c45c83eaa3b76d4d25342bedea7117fda3741539f734d18d85570

# 3. Vulnerability Scanner — NVD NIST (https://nvd.nist.gov/developers/request-an-api-key)
VITE_NVD_API_KEY=your_nvd_api_key_here

# 4. CryptoTrace AI — Etherscan (https://etherscan.io/apis)
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 5. CryptoTrace AI — TronGrid (https://www.trongrid.io)
VITE_TRONGRID_API_KEY=your_trongrid_api_key_here

