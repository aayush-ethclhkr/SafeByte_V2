# ── SafeByte Environment Variables — TEMPLATE ─────────────────────────────────
# Copy this file to .env and fill in your real keys.
# NEVER put real keys in this file — it IS committed to git.

# VirusTotal API key — get free key at https://www.virustotal.com
VITE_VT_API_KEY=your_virustotal_api_key_here

# NVD API key — get free key at https://nvd.nist.gov/developers/request-an-api-key
VITE_NVD_API_KEY=your_nvd_api_key_here

# EmailJS credentials — https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
